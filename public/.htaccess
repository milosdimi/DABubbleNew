# Angular SPA – alle Routen auf index.html umleiten (Client-Side-Routing).
# Ohne das gibt z. B. /login oder /reset-password?oobCode=... beim direkten
# Aufruf / Reload einen 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existierende Datei oder Ordner direkt ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Alles andere -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching
<IfModule mod_headers.c>
  # index.html nie cachen -> neue Uploads kommen sofort an
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # gehashte Dateinamen (main-ABC123.js usw.) + Fonts lange cachen
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
