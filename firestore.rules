rules_version = '2';

// Firestore Rules fuer DABubble.
// Deploy: npx firebase-tools deploy --only firestore:rules
//
// Grundsaetze:
// - Gaeste = anonymer Firebase-Login. Sie haben kein users-Dokument, sehen nur
//   Demo-User und Channels mit guestVisible == true.
// - Channel-Sichtbarkeit (identisch zu ChannelService.visibilityQueries):
//     guestVisible            -> alle eingeloggten (auch Gaeste)
//     name == "Office-Team"   -> alle registrierten
//     sonst                   -> nur Mitglieder (memberIds)
// - Loeschen ist nirgends vorgesehen.
// - Wer Sichtbarkeit fuer andere verleiht (isDemo, guestVisible, Name "Office-Team"),
//   entscheidet nur die Konsole/Seed; Clients koennen das weder anlegen noch setzen.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Helfer

    function signedIn() {
      return request.auth != null;
    }

    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegistered() {
      return signedIn() && !isGuest();
    }

    function uid() {
      return request.auth.uid;
    }

    /** Aendert das Update nur die genannten Felder? */
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function canReadChannel(channel) {
      return (signedIn() && channel.guestVisible == true)
        || (isRegistered() && (channel.name == 'Office-Team' || uid() in channel.memberIds));
    }

    /**
     * Wer darf die Mitgliederliste so aendern? Hinzufuegen: jedes Mitglied.
     * Entfernen: der Ersteller jeden, alle anderen nur sich selbst (austreten).
     */
    function isAllowedMemberChange(before, after) {
      let removed = before.memberIds.toSet().difference(after.memberIds.toSet());
      return removed.size() == 0
        || uid() == before.createdBy
        || removed == [uid()].toSet();
    }

    function channelData(channelId) {
      return get(/databases/$(database)/documents/channels/$(channelId)).data;
    }

    function isDmMember(dmId) {
      return signedIn()
        && uid() in get(/databases/$(database)/documents/directChats/$(dmId)).data.memberIds;
    }

    /** Neue Nachricht: eigener Absender, ID passt zum Dokument, Reactions leer. */
    function isValidNewMessage(messageId) {
      let data = request.resource.data;
      return data.senderId == uid()
        && data.id == messageId
        && data.text is string
        && data.timestamp is number
        && data.reactions == [];
    }

    /** Reactions setzen und den Antwort-Zaehler (+ Zeit der letzten Antwort) aktualisieren darf jeder Leser. */
    function isReactionOrCounterUpdate() {
      return onlyChanges(['reactions', 'replyCount', 'lastReplyAt', 'lastReplyBy'])
        && request.resource.data.get('lastReplyAt', 0) is number
        // Wer zuletzt geantwortet hat, darf nur man selbst sein.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReplyBy'])
            || request.resource.data.lastReplyBy == uid());
    }

    /** "Nachricht bearbeiten": nur der Absender, nur der Text. */
    function isOwnTextEdit() {
      return resource.data.senderId == uid()
        && resource.data.get('deleted', false) == false
        && onlyChanges(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.get('editedAt', 0) is number;
    }

    /**
     * "Nachricht loeschen": nur der Absender; die Nachricht bleibt als Platzhalter
     * stehen (Threads/Reaktionen bleiben stimmig), Text leer, Anhang entfernt.
     */
    function isOwnSoftDelete() {
      return resource.data.senderId == uid()
        && onlyChanges(['deleted', 'deletedAt', 'text', 'attachmentPath', 'attachmentName'])
        && request.resource.data.deleted == true
        && request.resource.data.text == ''
        && request.resource.data.deletedAt is number
        && !('attachmentPath' in request.resource.data)
        && !('attachmentName' in request.resource.data);
    }

    function isAllowedMessageUpdate() {
      return isReactionOrCounterUpdate() || isOwnTextEdit() || isOwnSoftDelete();
    }

    // ----------------------------------------------------------------- Users

    /** Status-Werte: angezeigt (onlineStatus) und selbst gewaehlt (chosenStatus). */
    function hasValidStatus(data) {
      let allowed = ['online', 'away', 'busy', 'offline'];
      return data.get('onlineStatus', 'online') in allowed
        && data.get('chosenStatus', 'online') in allowed;
    }

    match /users/{userId} {
      allow read: if isRegistered() || (isGuest() && resource.data.isDemo == true);
      // isDemo setzt nur die Konsole/Seed, nie der Client selbst.
      allow create: if isRegistered()
        && userId == uid()
        && request.resource.data.id == uid()
        && request.resource.data.get('isDemo', false) == false
        && hasValidStatus(request.resource.data);
      allow update: if isRegistered()
        && userId == uid()
        && onlyChanges(['name', 'avatarUrl', 'onlineStatus', 'chosenStatus'])
        && hasValidStatus(request.resource.data);
      allow delete: if false;

      // Gelesen-Stand pro Chat (rote Punkte in der Sidebar). Nur der User selbst,
      // auch Gaeste (ihr users-Dokument fehlt, die Unter-Collection geht trotzdem).
      match /readState/{chatKey} {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if signedIn()
          && uid() == userId
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is number;
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------- Channels

    match /channels/{channelId} {
      allow read: if canReadChannel(resource.data);

      // guestVisible und der Name "Office-Team" verleihen Sichtbarkeit fuer andere;
      // solche Channels legt nur die Konsole/Seed an, nie der Client.
      allow create: if isRegistered()
        && request.resource.data.id == channelId
        && request.resource.data.createdBy == uid()
        && uid() in request.resource.data.memberIds
        && request.resource.data.get('guestVisible', false) == false
        && request.resource.data.name != 'Office-Team';

      // Mitglieder duerfen Mitglieder hinzufuegen und selbst austreten; andere
      // entfernen darf nur der Ersteller. Name/Beschreibung aendern darf nur der
      // Ersteller, aber nicht in "Office-Team".
      allow update: if isRegistered()
        && uid() in resource.data.memberIds
        && onlyChanges(['name', 'description', 'memberIds'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'description'])
            || uid() == resource.data.createdBy)
        && (request.resource.data.name != 'Office-Team' || resource.data.name == 'Office-Team')
        && isAllowedMemberChange(resource.data, request.resource.data);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadChannel(channelData(channelId));
        allow create: if canReadChannel(channelData(channelId))
          && isValidNewMessage(messageId)
          && request.resource.data.channelId == channelId;
        allow update: if canReadChannel(channelData(channelId))
          && isAllowedMessageUpdate();
        allow delete: if false;

        match /replies/{replyId} {
          allow read: if canReadChannel(channelData(channelId));
          allow create: if canReadChannel(channelData(channelId))
            && isValidNewMessage(replyId)
            && request.resource.data.threadId == messageId;
          allow update: if canReadChannel(channelData(channelId))
            && isAllowedMessageUpdate();
          allow delete: if false;
        }
      }
    }

    // ----------------------------------------------------------- Direktchats

    match /directChats/{dmId} {
      allow read: if signedIn() && uid() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.id == dmId
        && request.resource.data.memberIds.size() == 2
        && uid() in request.resource.data.memberIds;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isDmMember(dmId);
        allow create: if isDmMember(dmId)
          && isValidNewMessage(messageId)
          && request.resource.data.dmId == dmId;
        allow update: if isDmMember(dmId) && isAllowedMessageUpdate();
        allow delete: if false;

        match /replies/{replyId} {
          allow read: if isDmMember(dmId);
          allow create: if isDmMember(dmId)
            && isValidNewMessage(replyId)
            && request.resource.data.threadId == messageId;
          allow update: if isDmMember(dmId) && isAllowedMessageUpdate();
          allow delete: if false;
        }
      }
    }
  }
}
