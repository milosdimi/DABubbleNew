# Vorlage fuer die Umgebungsvariablen des Presign-Dienstes.
# In Container Station stehen die Werte direkt in docker-compose.yml;
# fuer einen lokalen Start: nach .env kopieren (wird nicht versioniert).

# Oeffentliche MinIO-Adresse (Cloudflare Tunnel). Damit wird signiert -
# der Host ist Teil der Signatur, deshalb NICHT die interne Adresse.
S3_PUBLIC_ENDPOINT=https://storage.join-dimit.cc
# Optional: interne Adresse im Docker-Netz, nur fuer die Existenzpruefung.
S3_INTERNAL_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=chat-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=

FIREBASE_PROJECT_ID=dababble
ALLOWED_ORIGINS=https://dabubble.dimit.cc,http://localhost:4200
MAX_UPLOAD_BYTES=10485760
UPLOADS_PER_HOUR=20
PORT=3000
