{
  "rules": {
    "status": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && newData.child('lastChanged').isNumber()",
        "state": { ".validate": true },
        "lastChanged": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "typing": {
      "$chat": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('at').isNumber()",
          "name": { ".validate": true },
          "at": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
